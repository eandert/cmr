# Datasets / large inputs (V2V4Real & DAIR exports, dumped tapes, etc.) — top-level only,
# so this does NOT match src/data/ (the in-repo GPEM sensor models).
/data/

# Deferred V2V4Real sensor-model aliases: symlinks under src/data/ that point INTO data/
# (dangling for a cloner). Materialize them in the data-packaging pass. Verified: no real
# model matches these globs.
src/data/sensor_models/mix_*
src/data/sensor_models/u_*
src/data/sensor_models/centerpoint_100m_v2v4real_finetune_*
src/data/sensor_models/pointpillar_v2v4real_astuff_polar_calibration.csv
src/data/sensor_models/pointpillar_v2v4real_tesla_polar_calibration.csv

# Local developer paths (machine-specific; commit paths.local.yaml.example instead)
paths.local.yaml

# Local symlink to an external peer repo (points off-machine; not for cloners)
third_party/

# Quarantine / recycling-bin dirs anywhere (tests/old, scripts/old,
# src/data/sensor_models/old, ...) — not for the public repo
old/

# SUMO outputs
*.sumo.cfg.bak

# Claude Code local settings
.claude/

# Internal/working docs — not published
docs/dev/
